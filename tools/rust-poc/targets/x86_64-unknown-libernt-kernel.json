{
  "abi-return-struct-as-int": true,
  "arch": "x86_64",
  "binary-format": "coff",
  "code-model": "kernel",
  "cpu": "x86-64",
  "crt-objects-fallback": "mingw",
  "data-layout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128",
  "disable-redzone": true,
  "dll-prefix": "",
  "dll-suffix": ".dll",
  "dll-tls-export": false,
  "dynamic-linking": true,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "env": "gnu",
  "exe-suffix": ".exe",
  "features": "+cmpxchg16b,+sse3,+lahfsahf,-mmx",
  "function-sections": false,
  "is-like-windows": true,
  "late-link-args": {
    "gnu": [
      "-lmsvcrt",
      "-lmingwex",
      "-lmingw32",
      "-lgcc",
      "-lmsvcrt",
      "-lmingwex",
      "-luser32",
      "-lkernel32"
    ],
    "gnu-cc": [
      "-lmsvcrt",
      "-lmingwex",
      "-lmingw32",
      "-lgcc",
      "-lmsvcrt",
      "-lmingwex",
      "-luser32",
      "-lkernel32"
    ],
    "gnu-lld": [
      "-lmsvcrt",
      "-lmingwex",
      "-lmingw32",
      "-lgcc",
      "-lmsvcrt",
      "-lmingwex",
      "-luser32",
      "-lkernel32"
    ],
    "gnu-lld-cc": [
      "-lmsvcrt",
      "-lmingwex",
      "-lmingw32",
      "-lgcc",
      "-lmsvcrt",
      "-lmingwex",
      "-luser32",
      "-lkernel32"
    ]
  },
  "late-link-args-dynamic": {
    "gnu": [
      "-lgcc_s"
    ],
    "gnu-cc": [
      "-lgcc_s"
    ],
    "gnu-lld": [
      "-lgcc_s"
    ],
    "gnu-lld-cc": [
      "-lgcc_s"
    ]
  },
  "late-link-args-static": {
    "gnu": [
      "-lgcc_eh",
      "-l:libpthread.a"
    ],
    "gnu-cc": [
      "-lgcc_eh",
      "-l:libpthread.a"
    ],
    "gnu-lld": [
      "-lgcc_eh",
      "-l:libpthread.a"
    ],
    "gnu-lld-cc": [
      "-lgcc_eh",
      "-l:libpthread.a"
    ]
  },
  "linker": "x86_64-w64-mingw32-gcc",
  "linker-flavor": "gnu-cc",
  "llvm-target": "x86_64-pc-windows-gnu",
  "max-atomic-width": 128,
  "os": "windows",
  "panic-strategy": "abort",
  "plt-by-default": false,
  "pre-link-args": {
    "gnu": [
      "--dynamicbase",
      "--disable-auto-image-base",
      "-m",
      "i386pep",
      "--high-entropy-va"
    ],
    "gnu-cc": [
      "-fno-use-linker-plugin",
      "-Wl,--dynamicbase",
      "-Wl,--disable-auto-image-base",
      "-m64",
      "-Wl,--high-entropy-va"
    ],
    "gnu-lld": [
      "--dynamicbase",
      "--disable-auto-image-base",
      "-m",
      "i386pep",
      "--high-entropy-va"
    ],
    "gnu-lld-cc": [
      "-fno-use-linker-plugin",
      "-Wl,--dynamicbase",
      "-Wl,--disable-auto-image-base",
      "-m64",
      "-Wl,--high-entropy-va"
    ]
  },
  "pre-link-objects-fallback": {
    "dynamic-dylib": [
      "dllcrt2.o"
    ],
    "dynamic-nopic-exe": [
      "crt2.o"
    ],
    "dynamic-pic-exe": [
      "crt2.o"
    ],
    "static-dylib": [
      "dllcrt2.o"
    ],
    "static-nopic-exe": [
      "crt2.o"
    ],
    "static-pic-exe": [
      "crt2.o"
    ]
  },
  "requires-uwtable": true,
  "target-family": [
    "windows"
  ],
  "target-mcount": "_mcount",
  "target-pointer-width": 64,
  "vendor": "unknown"
}
