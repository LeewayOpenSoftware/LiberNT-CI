; LiberNT theme (LiberNT Blue)
[Theme]
DisplayName=LiberNT Blue

[Control Panel\Desktop]
Wallpaper=%SystemRoot%\Web\Wallpaper\BlueHorizon.png
WallpaperStyle=10
TileWallpaper=0
ScreenSaveTimeOut=600
ScreenSaveActive=0

[Control Panel\Colors]
ActiveTitle=0 102 204

[Sounds]
SchemeName=.Default

[boot]
SCRNSAVE.EXE=

[MasterThemeSelector]
MTSM=DABJDKT
