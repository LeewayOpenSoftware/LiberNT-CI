; Orosi theme (Orosi Green)
[Theme]
DisplayName=Orosi Green

[Control Panel\Desktop]
Wallpaper=%SystemRoot%\Web\Wallpaper\Forest Canopy.jpg
WallpaperStyle=10
TileWallpaper=0
ScreenSaveTimeOut=600
ScreenSaveActive=0

[Control Panel\Colors]
ActiveTitle=46 125 50

[Sounds]
SchemeName=.Default

[boot]
SCRNSAVE.EXE=

[MasterThemeSelector]
MTSM=DABJDKT
