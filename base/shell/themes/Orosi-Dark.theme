; Orosi theme (Orosi Dark)
[Theme]
DisplayName=Orosi Dark

[Control Panel\Desktop]
Wallpaper=%SystemRoot%\Web\Wallpaper\Night Sky.jpg
WallpaperStyle=10
TileWallpaper=0
ScreenSaveTimeOut=600
ScreenSaveActive=0

[Control Panel\Colors]
ActiveTitle=64 64 64

[Sounds]
SchemeName=.Default

[boot]
SCRNSAVE.EXE=

[MasterThemeSelector]
MTSM=DABJDKT
