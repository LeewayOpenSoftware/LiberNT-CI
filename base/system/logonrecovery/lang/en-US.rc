LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_RECOVERY DIALOGEX 0, 0, 230, 168
STYLE DS_SHELLFONT | DS_CENTER | WS_POPUP | WS_CAPTION
CAPTION "Orosi"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Sign in", IDC_TITLE, 12, 8, 206, 10
    LTEXT "User name:", IDC_USER_LABEL, 12, 26, 60, 8
    EDITTEXT IDC_USER, 76, 24, 142, 13, ES_AUTOHSCROLL
    LTEXT "Password:", IDC_PASSWORD_LABEL, 12, 44, 60, 8
    EDITTEXT IDC_PASSWORD, 76, 42, 142, 13, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "Old password:", IDC_OLD_LABEL, 12, 44, 60, 8, NOT WS_VISIBLE
    EDITTEXT IDC_OLD, 76, 42, 142, 13, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_VISIBLE
    LTEXT "New password:", IDC_NEW_LABEL, 12, 62, 60, 8, NOT WS_VISIBLE
    EDITTEXT IDC_NEW, 76, 60, 142, 13, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_VISIBLE
    LTEXT "Confirm:", IDC_CONFIRM_LABEL, 12, 80, 60, 8, NOT WS_VISIBLE
    EDITTEXT IDC_CONFIRM, 76, 78, 142, 13, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_VISIBLE
    LTEXT "", IDC_STATUS, 12, 100, 206, 26
    DEFPUSHBUTTON "Sign &in", IDC_SIGNIN, 152, 132, 66, 14
    PUSHBUTTON "&Restart", IDC_RESTART, 12, 148, 60, 14
    PUSHBUTTON "Shut &down", IDC_SHUTDOWN, 76, 148, 60, 14
END

STRINGTABLE
BEGIN
    IDS_TITLE_LOGON "Sign in"
    IDS_TITLE_UNLOCK "This computer is locked. Sign in to unlock it."
    IDS_TITLE_CHANGE "Your password must be changed before you sign in."
    IDS_WELCOME "Welcome, %s"
    IDS_FAILED "Sign-in failed (0x%08lX)."
    IDS_MISMATCH "The new passwords do not match."
    IDS_REFUSED "The request was not accepted (%lu)."
END
