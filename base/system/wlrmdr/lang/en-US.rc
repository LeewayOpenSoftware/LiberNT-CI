LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_REMINDER DIALOGEX 0, 0, 260, 72
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "Logon reminder"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON            "", IDC_REM_ICON, 10, 10, 20, 20
    LTEXT           "", IDC_REM_MESSAGE, 40, 10, 210, 32
    DEFPUSHBUTTON   "&Close", IDCLOSE, 200, 50, 50, 14
END
