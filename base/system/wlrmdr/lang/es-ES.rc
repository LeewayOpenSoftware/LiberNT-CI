LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

IDD_REMINDER DIALOGEX 0, 0, 260, 72
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "Recordatorio de inicio de sesión"
FONT 8, "MS Shell Dlg"
BEGIN
