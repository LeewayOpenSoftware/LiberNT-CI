#include <windef.h>

#include "resource.h"

#define REACTOS_STR_FILE_DESCRIPTION  "Task Scheduler Configuration Tool"
#define REACTOS_STR_INTERNAL_NAME     "schtasks"
#define REACTOS_STR_ORIGINAL_FILENAME "schtasks.exe"
#include <reactos/version.rc>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

STRINGTABLE
BEGIN
    IDS_CREATE_SUCCESS "SUCCESS: The scheduled task ""%s"" has successfully been created.\n"
    IDS_DELETE_SUCCESS "SUCCESS: The scheduled task ""%s"" was successfully deleted.\n"
    IDS_CHANGE_SUCCESS "SUCCESS: The parameters of scheduled task ""%s"" have been changed.\n"
END
