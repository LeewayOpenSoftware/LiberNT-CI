# Fails the build when a forbidden test-hook string is present in the image.
# Invoked post-build from CMakeLists.txt when LIBERNT_MSGINA_TEST_HOOKS is OFF.
# The hook trigger is a wide string in code, so search both UTF-16LE and ASCII.
if(NOT DLL OR NOT NEEDLE)
    message(FATAL_ERROR "nohooks: DLL or NEEDLE not given")
endif()
if(NOT EXISTS "${DLL}")
    message(FATAL_ERROR "nohooks: ${DLL} does not exist")
endif()
file(READ "${DLL}" content HEX)
string(TOUPPER "${content}" content)
string(LENGTH "${NEEDLE}" needle_len)
math(EXPR needle_last "${needle_len} - 1")
set(needle_wide "")
set(needle_ascii "")
foreach(i RANGE ${needle_last})
    string(SUBSTRING "${NEEDLE}" ${i} 1 ch)
    string(HEX "${ch}" ch_hex)
    string(TOUPPER "${ch_hex}" ch_hex)
    string(APPEND needle_wide "${ch_hex}00")
    string(APPEND needle_ascii "${ch_hex}")
endforeach()
string(FIND "${content}" "${needle_wide}" found_wide)
string(FIND "${content}" "${needle_ascii}" found_ascii)
if(NOT found_wide EQUAL -1 OR NOT found_ascii EQUAL -1)
    message(FATAL_ERROR "nohooks: ${DLL} contains the forbidden test-hook string '${NEEDLE}' (wide at ${found_wide}, ascii at ${found_ascii}); build with -DLIBERNT_MSGINA_TEST_HOOKS=ON only in a lab")
endif()
