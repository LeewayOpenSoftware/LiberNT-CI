LANGUAGE LANG_GERMAN, SUBLANG_NEUTRAL

IDD_PROPPAGEGENERAL DIALOGEX 0, 0, 246, 125
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Allgemein"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_CPLICON, IDI_CPLICON, 8, 0, 21, 20
    GROUPBOX "Shader", -1, 5, 25, 230, 65
    LTEXT "Maximaler GS Level:", -1, 15, 42, 120, 10
    COMBOBOX IDC_GSLEVEL, 135, 40, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
    LTEXT "Maximaler PS Level:", -1, 15, 57, 120, 10
    COMBOBOX IDC_PSLEVEL, 135, 55, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
    LTEXT "Maximaler VS Level:", -1, 15, 72, 120, 10
    COMBOBOX IDC_VSLEVEL, 135, 70, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
    GROUPBOX "Darstellung", -1, 5, 95, 230, 25
    LTEXT "Videospeicher-Größe:", -1, 15, 105, 120, 10, SS_LEFT
    COMBOBOX IDC_VIDMEMSIZE, 135, 103, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
END

STRINGTABLE
BEGIN
    IDS_CPLNAME "WineD3D Einstellungen"
    IDS_CPLDESCRIPTION "Konfiguriert WineD3D Runtime Einstellungen."
END
