LANGUAGE LANG_ITALIAN, SUBLANG_NEUTRAL

IDD_PROPPAGEGENERAL DIALOGEX 0, 0, 246, 125
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Generale"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_CPLICON, IDI_CPLICON, 8, 0, 21, 20
    GROUPBOX "Shaders", -1, 5, 25, 230, 65
    LTEXT "Livello massimo GS:", -1, 15, 42, 120, 10
    COMBOBOX IDC_GSLEVEL, 135, 40, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
    LTEXT "Livello massimo PS:", -1, 15, 57, 120, 10
    COMBOBOX IDC_PSLEVEL, 135, 55, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
    LTEXT "Livello massimo VS:", -1, 15, 72, 120, 10
    COMBOBOX IDC_VSLEVEL, 135, 70, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
    GROUPBOX "Rendering", -1, 5, 95, 230, 25
    LTEXT "Dimensione memoria video:", -1, 15, 105, 120, 10, SS_LEFT
    COMBOBOX IDC_VIDMEMSIZE, 135, 103, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
END

STRINGTABLE
BEGIN
    IDS_CPLNAME "Opzioni WineD3D"
    IDS_CPLDESCRIPTION "Configura le impostazioni di runtime di WineD3D."
END
