LANGUAGE LANG_TURKISH, SUBLANG_DEFAULT

IDD_PROPPAGEGENERAL DIALOGEX 0, 0, 246, 125
STYLE DS_SHELLFONT | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Genel"
FONT 8, "MS Shell Dlg"
BEGIN
    ICON IDI_CPLICON, IDI_CPLICON, 8, 0, 21, 20
    GROUPBOX "Gölgelendiriciler", -1, 5, 25, 230, 65
    LTEXT "&GS düzeyi en çok:", -1, 15, 42, 120, 10
    COMBOBOX IDC_GSLEVEL, 135, 40, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
    LTEXT "&PS düzeyi en çok:", -1, 15, 57, 120, 10
    COMBOBOX IDC_PSLEVEL, 135, 55, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
    LTEXT "&VS düzeyi en çok:", -1, 15, 72, 120, 10
    COMBOBOX IDC_VSLEVEL, 135, 70, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
    GROUPBOX "İşleme", -1, 5, 95, 230, 25
    LTEXT "Video &belleği boyutu:", -1, 15, 105, 120, 10, SS_LEFT
    COMBOBOX IDC_VIDMEMSIZE, 135, 103, 90, 10, WS_TABSTOP | WS_VSCROLL | CBS_DROPDOWNLIST
END

STRINGTABLE
BEGIN
    IDS_CPLNAME "WineD3D Seçenekleri"
    IDS_CPLDESCRIPTION "WineD3D çalışma zamanı ayarlarını yapılandırır."
END
