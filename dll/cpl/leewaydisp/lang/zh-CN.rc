IDD_GRAPHICS DIALOGEX 0, 0, 310, 190
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX "Direct3D", IDC_STATIC, 6, 2, 298, 134
    LTEXT "图形引擎:", IDC_STATIC, 14, 15, 92, 10
    COMBOBOX IDC_GFX_RENDERER, 112, 13, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "着色器后端:", IDC_STATIC, 14, 32, 92, 10
    COMBOBOX IDC_GFX_SHADER, 112, 30, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "多重采样:", IDC_STATIC, 14, 49, 92, 10
    COMBOBOX IDC_GFX_MSAA, 112, 47, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "显存:", IDC_STATIC, 14, 66, 92, 10
    COMBOBOX IDC_GFX_VIDMEM, 112, 64, 140, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "几何 (GS):", IDC_STATIC, 14, 83, 92, 10
    COMBOBOX IDC_GFX_GSLEVEL, 112, 81, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "像素 (PS):", IDC_STATIC, 14, 100, 92, 10
    COMBOBOX IDC_GFX_PSLEVEL, 112, 98, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "顶点 (VS):", IDC_STATIC, 14, 117, 92, 10
    COMBOBOX IDC_GFX_VSLEVEL, 112, 115, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "OpenGL", IDC_STATIC, 6, 140, 298, 30
    LTEXT "实现:", IDC_STATIC, 14, 153, 92, 10
    COMBOBOX IDC_GFX_OGL, 112, 151, 140, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
