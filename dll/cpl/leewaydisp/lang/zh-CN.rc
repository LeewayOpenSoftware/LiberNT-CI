LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

STRINGTABLE
BEGIN
    IDS_CPL_PERSONALIZE_NAME "个性化"
    IDS_CPL_PERSONALIZE_DESC "更改桌面背景并查看显示器的设置情况。"
    IDS_CPL_DISPLAY_NAME "显示"
    IDS_CPL_DISPLAY_DESC "检查显示器并更改屏幕分辨率。"
    IDS_TITLE "显示和个性化"
    IDS_TAB_PERSONALIZE "个性化"
    IDS_TAB_DISPLAY "显示"
    IDS_STYLE_FILL "填充"
    IDS_STYLE_FIT "适应"
    IDS_STYLE_STRETCH "拉伸"
    IDS_STYLE_TILE "平铺"
    IDS_STYLE_CENTER "居中"
    IDS_WALL_FAILED "无法更改背景。"
    IDS_NO_WALLPAPERS "在 Web\\Wallpaper 文件夹中未找到图片。"
    IDS_CURRENT_WALLPAPER "当前背景: %s"
    IDS_NO_MONITORS "未找到显示器。"
    IDS_MONITOR_FORMAT "%u. %s"
    IDS_MONITOR_DETACHED "(未连接到桌面)"
    IDS_MODE_FORMAT "%u x %u"
    IDS_HZ_FORMAT "%u Hz"
    IDS_HZ_DEFAULT "硬件默认值"
    IDS_INFO_FORMAT "适配器: %s\n监视器: %s\n当前模式: %u x %u，%u 位，%u Hz\n桌面位置: %d, %d\n系统缩放: %u%%"
    IDS_APPLY_UNSUPPORTED "显示驱动程序不支持此模式。"
    IDS_APPLY_FAILED "无法更改显示模式。"
    IDS_APPLY_RESTART "更改将在重新启动计算机后生效。"
    IDS_KEEP_TEXT "保留这些显示设置吗？%d 秒后将恢复为之前的设置。"
    IDS_DPI_FORMAT "%u%%"
    IDS_CAPS_LIMITS "暂不可用：多显示器布局、主显示器和每显示器缩放。"
END

IDD_MAIN DIALOGEX 0, 0, 330, 250
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "显示和个性化"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL "", IDC_TAB, "SysTabControl32", WS_CLIPSIBLINGS | WS_TABSTOP, 6, 6, 318, 214
    DEFPUSHBUTTON "关闭", IDCANCEL, 274, 228, 50, 14
END

IDD_PERSONALIZE DIALOGEX 0, 0, 310, 190
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "选择桌面背景图片:", IDC_STATIC, 6, 6, 298, 10
    CONTROL "", IDC_WALL_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER | WS_BORDER | WS_TABSTOP, 6, 20, 120, 120
    CONTROL "", IDC_WALL_PREVIEW, "Static", SS_OWNERDRAW, 134, 20, 170, 100
    LTEXT "图片位置:", IDC_STATIC, 134, 128, 60, 10
    COMBOBOX IDC_WALL_STYLE, 198, 126, 70, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "设为背景", IDC_WALL_APPLY, 134, 146, 80, 14, WS_TABSTOP
    LTEXT "", IDC_WALL_CURRENT, 6, 166, 298, 20
END

IDD_DISPLAY DIALOGEX 0, 0, 310, 190
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "显示器:", IDC_STATIC, 6, 8, 60, 10
    COMBOBOX IDC_DISP_MONITOR, 70, 6, 234, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "分辨率:", IDC_STATIC, 6, 26, 60, 10
    COMBOBOX IDC_DISP_RES, 70, 24, 100, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "刷新率:", IDC_STATIC, 6, 44, 60, 10
    COMBOBOX IDC_DISP_HZ, 70, 42, 100, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "应用", IDC_DISP_APPLY, 70, 62, 50, 14, WS_TABSTOP
    GROUPBOX "当前配置", IDC_STATIC, 6, 84, 298, 70
    LTEXT "", IDC_DISP_INFO, 12, 96, 286, 54
    LTEXT "", IDC_DISP_LIMITS, 6, 160, 298, 24
END

IDD_KEEP DIALOGEX 0, 0, 220, 70
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "显示设置"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_KEEP_TEXT, 10, 10, 200, 28
    DEFPUSHBUTTON "保留更改", IDOK, 50, 46, 60, 14
    PUSHBUTTON "还原", IDCANCEL, 116, 46, 60, 14
END
