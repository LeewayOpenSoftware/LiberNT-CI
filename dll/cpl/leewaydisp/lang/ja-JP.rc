    COMBOBOX IDC_GFX_SHADER, 112, 31, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "レンダリング", IDC_STATIC, 6, 56, 298, 52
    LTEXT "マルチサンプリング:", IDC_STATIC, 14, 69, 92, 10
    COMBOBOX IDC_GFX_MSAA, 112, 67, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "ビデオメモリ:", IDC_STATIC, 14, 87, 92, 10
    COMBOBOX IDC_GFX_VIDMEM, 112, 85, 140, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    GROUPBOX "シェーダーモデルの制限", IDC_STATIC, 6, 110, 298, 58
