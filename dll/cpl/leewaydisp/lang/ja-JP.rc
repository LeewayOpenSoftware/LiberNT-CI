    COMBOBOX IDC_GFX_GSLEVEL, 112, 121, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "ピクセル (PS):", IDC_STATIC, 14, 139, 92, 10
