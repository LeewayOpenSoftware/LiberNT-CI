LANGUAGE LANG_ITALIAN, SUBLANG_NEUTRAL

IDD_INSTALL DIALOG 0, 0, 205, 60
CAPTION "Installing fonts..."
STYLE DS_CENTER | DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Installing fonts...", IDC_INSTALL_TEXT, 5, 10, 195, 10
    CONTROL "", IDC_INSTALL_PROGRESS, "msctls_progress32", 0, 5, 25, 195, 10
    PUSHBUTTON "Cancel", IDCANCEL, 65, 40, 70, 15
END

STRINGTABLE
BEGIN
    IDS_REACTOS_FONTS_FOLDER "Cartella dei font di LiberNT"
    IDS_INSTALL_OK "The font(s) have been installed successfully."
    IDS_INSTALL_FAILED "Failed to install the font(s)."
    IDS_CONFIRM_DELETE_FONT "Do you want to delete the font(s)?"
    IDS_PROPERTIES "P&roperties"
    IDS_CANTDELETEFONT "Failed to delete the font(s)."
END

STRINGTABLE
BEGIN
    IDS_COL_NAME "Nome"
END

STRINGTABLE
BEGIN
    IDS_COL_FILENAME "Nome File"
    IDS_COL_SIZE "Dimensione"
    IDS_COL_MODIFIED "Modificato"
    IDS_COL_ATTR "Attributi"
END


STRINGTABLE
BEGIN
    IDS_FONT_PREVIEW "Anteprima"
END

STRINGTABLE
BEGIN
    IDS_COL_STYLE "Font style"
    IDS_COL_SHOWHIDE "Show/hide"
    IDS_COL_DESIGNEDFOR "Designed for"
    IDS_COL_CATEGORY "Category"
    IDS_COL_DESIGNER "Designer/foundry"
    IDS_COL_EMBED "Font embeddability"
    IDS_SHOW "Show"
    IDS_HIDE "Hide"
    IDS_CAT_TEXT "Text"
    IDS_CAT_DISPLAY "Display"
    IDS_CAT_SYMBOL "Symbol"
    IDS_EMB_INSTALLABLE "Installable"
    IDS_EMB_EDITABLE "Editable"
    IDS_EMB_PREVIEW "Preview and print"
    IDS_EMB_RESTRICTED "Restricted license"
    IDS_STYLES_FMT "%u styles"
    IDS_TASK_SETTINGS "Font settings"
    IDS_TASK_CLEARTYPE "Adjust ClearType text"
    IDS_TASK_CHARMAP "Find a character"
    IDS_FONT_HIDE_VERB "&Hide"
    IDS_FONT_SHOW_VERB "&Show"
    IDS_FONT_OPEN_VERB "&Open"
END
